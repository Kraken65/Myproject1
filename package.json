{
  "name": "velox",
  "version": "0.1.0",
  "description": "Velox — fast, low-fee custodial Solana trading bot for Telegram",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "selftest:crypto": "tsx src/scripts/selftest-crypto.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:quote": "tsx src/scripts/test-quote.ts"
  },
  "keywords": ["solana", "telegram", "trading-bot", "jupiter", "defi"],
  "license": "MIT",
  "dependencies": {
    "@grammyjs/ratelimiter": "^1.2.0",
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.32.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
